modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
build = "python3 artifacts/api-server/backend/scripts/deploy_window_guard.py && pnpm --filter @workspace/api-server build && PORT=5173 BASE_PATH=/ pnpm --filter @workspace/strategy-control-room build"
run = "cd artifacts/api-server && pnpm start"

[packager.features]
enabledForHosting = true

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-crash-recovery"

[[workflows.workflow]]
name = "backend-crash-recovery"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server/backend && PYTHONPATH=. python3.11 -m pytest -q tests/test_celery_worker_crash.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "libxcrypt", "postgresql", "redis"]

[userenv]

[userenv.shared]
ALLOW_LIVE_TRADING = "false"
ALLOW_ANONYMOUS_VIEWER = "true"
VITE_LOCAL_PAPER_AUTH = "true"
VITE_LOCAL_AUTO_VIEW = "true"
AGENT_RESEARCH_RULE_BASED_FALLBACK = "true"
# Reserved VM is a single durable instance, so the bounded paper worker pool
# can share its research-only embedded Redis lease without duplicate workers.
PAPER_WORKERS_ENABLED = "true"
PAPER_COMPACT_WORKER = "true"
PAPER_LEARNING_REPLICAS = "3"
PAPER_LEARNING_CONCURRENCY = "1"
# Liquid paper execution universe (index/sector ETFs + megacaps; matches the
# settings default). Each symbol still needs fresh authenticated intraday data;
# a stale symbol blocks only itself unless >20% of symbols or SPY/QQQ are stale.
PAPER_EXECUTION_SYMBOLS = "[\"SPY\", \"QQQ\", \"IWM\", \"DIA\", \"XLK\", \"XLF\", \"XLE\", \"XLV\", \"XLY\", \"XLP\", \"XLI\", \"XLU\", \"XLB\", \"XLRE\", \"XLC\", \"SMH\", \"AAPL\", \"MSFT\", \"NVDA\", \"AMZN\", \"GOOGL\", \"META\", \"TSLA\", \"AVGO\", \"JPM\", \"V\", \"MA\", \"UNH\", \"XOM\", \"LLY\", \"COST\", \"HD\", \"PG\", \"JNJ\", \"ABBV\", \"MRK\", \"PEP\", \"KO\", \"BAC\", \"WMT\", \"NFLX\", \"AMD\", \"CRM\", \"ORCL\", \"ADBE\"]"
# Updated for each deployable release so hosted readiness can be verified.
PAPER_BUILD_ID = "paper-slim-20261027-v1"
PAPER_EMBEDDED_REDIS = "true"
IEX_RESEARCH_ENABLED = "true"
# Feature refreshes retrain every symbol (~98 minutes here); queued from IEX
# observations they ran all session and starved the intraday import. The
# off-hours feature-generation crontab keeps predictions fresh instead.
IEX_FEATURE_REFRESH_ENABLED = "false"
# These direct loops remain research-only and never create live orders.
PAPER_DIRECT_RESEARCH_LOOP = "false"
# One Redis-leased research loop per symbol. These loops never submit orders.
PAPER_DIRECT_SCALP_RESEARCH_LOOP = "false"
PAPER_SCALP_RESEARCH_SYMBOLS = "AAPL,MSFT,SPY,QQQ"
# The Reserved VM sidecar coordinates both the paper queue and research loops.
PAPER_RESEARCH_EMBEDDED_REDIS = "true"
DELAYED_SIP_RESEARCH_ENABLED = "false"
# The 0.5 vCPU / 2 GiB VM hung under research load. Shed research-only beat
# entries so the paper trading, learning-cycle and monitoring jobs keep running.
PAPER_BEAT_EXCLUDE = "scalp-research-batch,scalp-research-queue-recovery,strategy-learning-batch-job,delayed-sip-collection"
# Queue one market-data import on every boot so a restart never leaves
# daily prices stale until the next scheduled import.
PAPER_STARTUP_REFRESH = "true"
PAPER_DIRECT_MONITOR_LOOP = "true"
PAPER_MONITOR_INTERVAL_SECONDS = "60"
# Let candidate/research strategies place small tagged paper orders (max 12
# open lots) so the learning loop gets outcomes quickly.
# Exploration fills never count as promotion evidence.
PAPER_EXPLORATION_ENABLED = "true"
# Broker-side bracket exits need whole shares; 1% of equity (~$1,000) keeps
# most of the universe tradable for exploration.
PAPER_EXPLORATION_RISK_FRACTION = "0.01"
ACTIVE_PAPER_BROKER = "alpaca_paper"
ALPACA_PAPER_ZERO_COMMISSION_CONTRACT = "true"
ALPACA_ACTIVITY_SSE_ENABLED = "true"
# The account is authenticated for the free IEX feed but is not entitled to
# Alpaca SIP. Keep paper research on the verified feed until SIP is entitled.
ACTIVE_MARKET_DATA_PROVIDER = "alpaca_iex"
INTRADAY_BACKFILL_CHUNKS_PER_CYCLE = "8"

[userenv.production]
ENVIRONMENT = "production"
CLERK_ROLE_MAPPINGS = "{\"user_3KQ4j0KxYM5iVpPz4Y0pnYC4mIR\":\"admin\",\"user_3KQ9CGy7ikGFcIHnxjKO2Vk89PD\":\"admin\"}"
