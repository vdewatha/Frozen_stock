modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "pnpm --filter @workspace/api-server build"
run = "cd artifacts/api-server && pnpm start"

[packager.features]
enabledForHosting = true

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-crash-recovery"

[[workflows.workflow]]
name = "backend-crash-recovery"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server/backend && PYTHONPATH=. python3.11 -m pytest -q tests/test_celery_worker_crash.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cups", "dbus", "expat", "glib", "glibcLocales", "libdrm", "libgbm", "libxcrypt", "libxkbcommon", "mesa", "nspr", "nss", "pango", "postgresql", "redis", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[userenv]

[userenv.shared]
ALLOW_LIVE_TRADING = "false"
ALLOW_ANONYMOUS_VIEWER = "true"
VITE_LOCAL_PAPER_AUTH = "true"
VITE_LOCAL_AUTO_VIEW = "true"
AGENT_RESEARCH_RULE_BASED_FALLBACK = "true"
PAPER_WORKERS_ENABLED = "true"
PAPER_LEARNING_REPLICAS = "3"
PAPER_LEARNING_CONCURRENCY = "1"
# Keep incomplete QQQ intraday history research-only until the feed gap is repaired.
PAPER_EXECUTION_SYMBOLS = "[\"AAPL\", \"MSFT\", \"SPY\"]"
PAPER_EMBEDDED_REDIS = "true"
IEX_RESEARCH_ENABLED = "true"
DELAYED_SIP_RESEARCH_ENABLED = "true"
PAPER_STARTUP_REFRESH = "true"
PAPER_DIRECT_MONITOR_LOOP = "true"
PAPER_MONITOR_INTERVAL_SECONDS = "60"
ACTIVE_PAPER_BROKER = "alpaca_paper"
ALPACA_PAPER_ZERO_COMMISSION_CONTRACT = "true"
ALPACA_ACTIVITY_SSE_ENABLED = "true"
ACTIVE_MARKET_DATA_PROVIDER = "alpaca_iex"
INTRADAY_BACKFILL_CHUNKS_PER_CYCLE = "8"

[userenv.production]
CLERK_ROLE_MAPPINGS = "{\"user_3KQ4j0KxYM5iVpPz4Y0pnYC4mIR\":\"admin\",\"user_3KQ9CGy7ikGFcIHnxjKO2Vk89PD\":\"admin\"}"
