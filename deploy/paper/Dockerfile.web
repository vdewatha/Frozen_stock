FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.11.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig*.json ./
COPY lib ./lib
COPY artifacts/strategy-control-room ./artifacts/strategy-control-room
RUN pnpm --filter @workspace/strategy-control-room... install --frozen-lockfile
ENV PORT=8080 BASE_PATH=/ NODE_ENV=production VITE_LOCAL_PAPER_AUTH=true VITE_LOCAL_AUTO_VIEW=true
RUN pnpm --filter @workspace/strategy-control-room build

FROM nginxinc/nginx-unprivileged:1.28-alpine
ENV NGINX_ENVSUBST_FILTER=LOCAL_VIEWER_KEY
COPY deploy/paper/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /workspace/artifacts/strategy-control-room/dist/public /usr/share/nginx/html
EXPOSE 8080
